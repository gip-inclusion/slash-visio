{
  "name": "slash-visio",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "esbuild src/handler.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/handler.js --external:aws-sdk && printf '{\"type\":\"commonjs\"}' > dist/package.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "smoke": "scripts/smoke.sh"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "eslint": "^10.10.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0"
  }
}
